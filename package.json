{
  "name": "recast-navigation-root",
  "private": true,
  "scripts": {
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm --filter @recast-navigation/wasm --filter @recast-navigation/core --filter @recast-navigation/generators --filter recast-navigation --filter @recast-navigation/three --filter @recast-navigation/playcanvas run build",
    "build:apps": "pnpm --filter navmesh-website --filter docs run build",
    "build:examples": "pnpm --filter recast-navigation-examples run build",
    "build:integration-examples": "pnpm --filter three-vite-example --filter three-vite-worker-example --filter playcanvas-vite-example run build",
    "docs": "(cd docs && node ./build.js)",
    "test": "pnpm test:packages && pnpm test:node-smoke-test",
    "test:packages": "pnpm --filter recast-navigation test",
    "test:node-smoke-test": "(cd ./examples-node/three-node-cjs-example && pnpm start) && (cd ./examples-node/three-node-esm-example && pnpm start)",
    "change": "changeset",
    "release": "pnpm build && pnpm test",
    "publish": "changeset publish",
    "version": "changeset version && pnpm install --lockfile-only",
    "format": "biome format --write apps/**/src packages/**/src examples/src examples-integrations/**/src",
    "lint": "biome lint --write apps/**/src packages/**/src examples/src examples-integrations/**/src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@changesets/cli": "^2.26.2",
    "vercel": "^33.7.0"
  },
  "packageManager": "pnpm@10.32.1"
}
